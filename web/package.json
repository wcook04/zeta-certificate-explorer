{
  "name": "zeta-certificate-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Every zero certificate in the Lean verification of the Riemann hypothesis up to height 10,011, with the computation behind selected certificates.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare-data": "python3 -B ../tools/export_downloads.py public/data public/downloads",
    "predev": "npm run prepare-data",
    "dev": "vite",
    "prebuild": "npm run prepare-data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/stix-two-text": "5.3.0",
    "d3-selection": "3.0.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
